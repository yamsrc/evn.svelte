{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "com.evnapp",
  "name": "Evnly",
  "short_name": "Evnly",
  "description": "Split wiser",
  "categories": [
    "social",
    "finance"
  ],
  "start_url": "/",
  "scope": "/",
  "theme_color": "#130A03",
  "background_color": "#130A03",
