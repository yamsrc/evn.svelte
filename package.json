{
	"name": "evn.svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --open --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"features": "npx play -x",
		"features:production": "BASE_URL=https://evnapp.com npm run features",
		"format": "eslint . --fix",
		"cert": "bash tools/cert.sh",
		"host": "npm run cert && pm2 start ecosystem.config.cjs",
		"restart": "npm run cert && pm2 restart ecosystem.config.cjs",
		"bump": "npx -y npm-check-updates --target minor -u"
	},
	"devDependencies": {
		"@commitlint/cli": "20.3.0",
		"@commitlint/config-conventional": "20.3.0",
		"@eslint/compat": "2.0.0",
		"@eslint/js": "^9.39.2",
		"@faker-js/faker": "10.1.0",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "0.562.0",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-vercel": "6.2.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.18",
		"@toa.io/origin": "^1.14.0",
		"@types/google.accounts": "^0.0.18",
		"@types/node": "^24",
		"@vercel/analytics": "^1.6.1",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"eslint": "^9.39.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"meros": "^1.3.2",
		"mitt": "3.0.1",
		"neostandard": "^0.12.2",
		"playwright-bdd": "8.4.2",
		"svas": "1.1.0",
		"svelte": "^5.46.0",
		"svelte-check": "^4.3.4",
		"svintl": "1.7.5",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"vite": "^7.3.0"
	},
	"bin": {
		"shad": "tools/shad.js",
		"play": "tools/play.js"
	},
	"dependencies": {
		"qr-code-styling": "^1.9.2"
	}
}
