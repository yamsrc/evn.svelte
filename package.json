{
  "name": "evn.svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --open --host",
    "build": "vite build",
    "rebuild": "npm i && npm run build && pm2 restart ui && npm run check",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "features": "npx play -x",
    "features:production": "BASE_URL=https://evnapp.com npm run features",
    "format": "eslint . --fix",
    "cert": "bash tools/cert.sh",
    "host": "npm run cert && pm2 start ecosystem.config.cjs",
    "restart": "npm run cert && pm2 restart ecosystem.config.cjs",
    "test": "vitest --run",
    "clip": "printf \"https://%s:15173\" $(ipconfig getifaddr en0) | pbcopy",
    "bump": "npx -y npm-check-updates --target minor -u"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@eslint/compat": "2.0.5",
    "@eslint/js": "9.39.4",
    "@faker-js/faker": "10.4.0",
    "@internationalized/date": "3.12.0",
    "@lucide/svelte": "1.8.0",
    "@playwright/test": "1.59.1",
    "@sveltejs/adapter-vercel": "6.3.3",
    "@sveltejs/kit": "2.57.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.2.2",
    "@toa.io/origin": "1.18.0",
    "@types/dom-navigation": "1.0.7",
    "@types/google.accounts": "0.0.18",
    "@types/negotiator": "0.6.4",
    "@types/node": "^24",
    "@types/semver": "7.7.1",
    "clsx": "2.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-svelte": "3.17.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.5.0",
    "husky": "^9.1.7",
    "neostandard": "0.13.0",
    "playwright-bdd": "8.5.0",
    "sharp-cli": "5.2.0",
    "svas": "1.7.1",
    "svelte": "5.55.3",
    "svelte-check": "4.4.6",
    "svintl": "1.12.2",
    "tailwind-merge": "3.5.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.58.2",
    "vite": "7.3.2",
    "vite-plugin-transform-lucide-imports": "0.3.0",
    "vitest": "4.1.4"
  },
  "bin": {
    "shad": "tools/shad.js",
    "play": "tools/play.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bits-ui": "^2.16.3",
    "meros": "1.3.2",
    "mitt": "3.0.1",
    "negotiator": "1.0.0",
    "qr-code-styling": "1.9.2",
    "semver": "7.7.4"
  }
}
